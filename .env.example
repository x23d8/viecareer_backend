APP_ENV=development
AUTH_MODE=clerk
# Local-only option: set AUTH_MODE=dev to bypass Clerk while testing checkout.
DEV_USER_ID=dev-local-user
DEV_USER_EMAIL=dev@local.test
DEV_USER_NAME=Development User
ENABLE_DB_ADMIN_ROUTES=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_ASR_MODEL=gpt-4o-mini-transcribe
OPENAI_POLISH_MODEL=gpt-4o
OPENAI_REALTIME_MODEL=gpt-realtime-mini-2025-12-15
OPENAI_REALTIME_CONNECT_URL=https://api.openai.com/v1/realtime/calls
REALTIME_VOICE_MODE=realtime_conversation
REALTIME_SHOW_TRANSCRIPT=true
CLERK_JWKS_URL=https://your-clerk-domain.example/.well-known/jwks.json
CLERK_ISSUER=https://your-clerk-domain.example
CLERK_SECRET_KEY=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Leave disabled in production. Localhost is enabled automatically for APP_ENV=development.
CORS_ORIGIN_REGEX=https?://(localhost|127\.0\.0\.1)(:\d+)?
SUPABASE_URL=https://your-project.supabase.co
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/DATABASE
SUPABASE_DB_URL=postgresql://USER:PASSWORD@HOST:6543/DATABASE
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
FRONTEND_BASE_URL=http://localhost:3000
PAYOS_RETURN_URL=http://localhost:3000/billing/return
PAYOS_CANCEL_URL=http://localhost:3000/billing/cancel
BILLING_JOB_SECRET=change-me-local-secret

# Optional shared rate-limit storage for multi-instance deployments.
RATE_LIMIT_STORAGE_URI=redis://redis:6379/0

# Job-market sync. Run scripts/sync_market_jobs.py from cron (for example every 6 hours).
JOB_SYNC_SECRET=change-me-job-sync-secret
JOB_CRAWLER_USER_AGENT=VieCareerJobIndexer/1.0 (+mailto:jobs@viecareer.site)
JOB_SOURCE_REQUEST_DELAY_SECONDS=1.5
JOB_SOURCE_MAX_DETAILS=100

# Third-party connectors remain off until written permission is obtained from each owner.
# Setting AUTHORIZED=true is an operator attestation; it does not itself grant permission.
JOB_SOURCE_LINKEDIN_ENABLED=false
JOB_SOURCE_LINKEDIN_AUTHORIZED=false
JOB_SOURCE_LINKEDIN_LISTING_URLS=https://www.linkedin.com/jobs/search/?location=Vietnam
JOB_SOURCE_TOPCV_ENABLED=false
JOB_SOURCE_TOPCV_AUTHORIZED=false
JOB_SOURCE_TOPCV_LISTING_URLS=https://www.topcv.vn/viec-lam
JOB_SOURCE_ITVIEC_ENABLED=false
JOB_SOURCE_ITVIEC_AUTHORIZED=false
JOB_SOURCE_ITVIEC_LISTING_URLS=https://itviec.com/it-jobs
