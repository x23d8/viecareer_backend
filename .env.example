APP_ENV=production
ENABLE_DB_ADMIN_ROUTES=false

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_REALTIME_MODEL=gpt-realtime-mini-2025-12-15

CLERK_JWKS_URL=https://your-clerk-domain.example/.well-known/jwks.json
CLERK_ISSUER=https://your-clerk-domain.example

CORS_ORIGINS=https://viecareer.site,https://www.viecareer.site
# Leave disabled in production. Localhost is enabled automatically for APP_ENV=development.
CORS_ORIGIN_REGEX=(?!)
SUPABASE_URL=https://your-project.supabase.co
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/DATABASE
SUPABASE_DB_URL=postgresql://USER:PASSWORD@HOST:6543/DATABASE

PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
FRONTEND_BASE_URL=https://www.viecareer.site
PAYOS_RETURN_URL=https://www.viecareer.site/billing/return
PAYOS_CANCEL_URL=https://www.viecareer.site/billing/cancel
BILLING_JOB_SECRET=
