
# ─────────────────────────────────────────────
# Backend — FastAPI environment variables
# Copy this file to .env and fill in the values
# ─────────────────────────────────────────────

# OpenAI API key (required)
OPENAI_API_KEY=<KEY>

# Chat / analysis model (default: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# Realtime voice interview model (default: gpt-realtime-2)
OPENAI_REALTIME_MODEL=gpt-realtime-mini-2025-12-15

# Clerk authentication (required)
CLERK_JWKS_URL=https://clerk.viecareer.site/.well-known/jwks.json
# Optional strict issuer check. Leave blank if Clerk tokens use a different issuer.
CLERK_ISSUER=

# CORS — comma-separated list of allowed origins.
# Use * to allow all origins (local dev only).
# Example for production: https://viecareer.vercel.app,https://www.viecareer.site
CORS_ORIGINS=*

# Port used by the Docker container (set by the hosting platform, e.g. Render)
# PORT=8000
SUPABASE_URL=
DATABASE_URL=<>
SUPABASE_DB_URL=<>
